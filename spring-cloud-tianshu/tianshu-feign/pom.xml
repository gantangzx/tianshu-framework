<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gantang</groupId>
        <artifactId>spring-cloud-tianshu</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tianshu-feign</artifactId>

    <name>tianshu-feign</name>
    <description>OpenFeign 封装：内置负载均衡与 Nacos 服务发现，鉴权/链路/灰度请求头透传，开箱即用</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 按服务名调用所需的客户端负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!--
          服务发现解耦：Feign 本身不绑定任何注册中心。
          tianshu-nacos 设为 optional（不传递），仅在开发者显式需要 Nacos 时由使用方自行引入，
          避免只想用声明式调用的用户被强制带入 nacos-client。
          也可替换为其它 DiscoveryClient 实现（Eureka/Consul 等）。
        -->
        <dependency>
            <groupId>com.gantang</groupId>
            <artifactId>tianshu-nacos</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
