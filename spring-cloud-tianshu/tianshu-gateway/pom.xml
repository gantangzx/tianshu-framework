<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gantang</groupId>
        <artifactId>spring-cloud-tianshu</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tianshu-gateway</artifactId>

    <name>tianshu-gateway</name>
    <description>Spring Cloud Gateway 封装，支持服务发现路由与 Swagger 文档聚合，开箱即用</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Swagger UI（webjar），访问 /swagger-ui.html 即可查看聚合文档 -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>swagger-ui</artifactId>
            <version>5.21.0</version>
        </dependency>
        <!--
          服务发现解耦：Gateway 本身不绑定任何注册中心。
          tianshu-nacos 设为 optional（不传递），需要 lb:// 服务路由时由使用方自行显式引入，
          避免只想做反向代理/路径转发的用户被强制带入 nacos-client。
          也可替换为其它 DiscoveryClient 实现。
        -->
        <dependency>
            <groupId>com.gantang</groupId>
            <artifactId>tianshu-nacos</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
